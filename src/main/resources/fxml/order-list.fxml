<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.homedepot.fulfillment.ui.OrderListController"
            styleClass="associate-root">

    <top>
        <VBox>
            <!-- Dark header -->
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="associate-header">
                <Label text="&#8592;" styleClass="associate-back" onMouseClicked="#onBackClick">
                    <font><Font size="20"/></font>
                </Label>
                <VBox spacing="1">
                    <Label text="HOME DEPOT" styleClass="associate-header-eyebrow"/>
                    <Label text="Store Fulfillment" styleClass="associate-header-title">
                        <font><Font name="System Bold" size="22"/></font>
                    </Label>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="timeLabel" text="" styleClass="associate-time">
                        <font><Font name="System Bold" size="20"/></font>
                    </Label>
                    <Label fx:id="dateLabel" text="" styleClass="associate-date"/>
                </VBox>
            </HBox>

            <!-- Stats + action bar -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="associate-stats-bar">
                <Label fx:id="statsLabel" text="Loading orders..." styleClass="associate-stats-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" styleClass="associate-refresh-btn" onAction="#onRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="mainScroll" fitToWidth="true" styleClass="associate-scroll" hbarPolicy="NEVER">
            <FlowPane fx:id="orderGrid" hgap="16" vgap="16"
                      alignment="TOP_LEFT" styleClass="associate-order-grid">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>

</BorderPane>
