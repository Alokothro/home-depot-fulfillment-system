<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- StackPane root so the partial-reason overlay can layer on top -->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.homedepot.fulfillment.ui.PickingController">

    <!-- ── Main picking screen ── -->
    <BorderPane styleClass="associate-root">
        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="associate-header">
                    <Label text="&#8592;" styleClass="associate-back" onMouseClicked="#onBackClick">
                        <font><Font size="20"/></font>
                    </Label>
                    <VBox spacing="3">
                        <Label fx:id="orderTitleLabel" text="" styleClass="pick-order-id"/>
                        <Label fx:id="customerLabel"   text="" styleClass="pick-customer-label"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="progressLabel" text="0 / 0 picked" styleClass="pick-progress-counter">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>
                </HBox>
                <ProgressBar fx:id="progressBar" progress="0.0"
                             maxWidth="Infinity" prefHeight="5"
                             styleClass="pick-progress-bar"/>
            </VBox>
        </top>

        <center>
            <VBox>
                <VBox styleClass="pick-scan-bar" spacing="6">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="scanField"
                                   promptText="Scan barcode or type SKU, then press Enter"
                                   styleClass="pick-scan-field" onAction="#onScan"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Scan" styleClass="pick-scan-button" onAction="#onScan" prefWidth="88"/>
                    </HBox>
                    <Label fx:id="scanFeedback" text="" styleClass="pick-scan-feedback" wrapText="true"/>
                </VBox>
                <ScrollPane fitToWidth="true" styleClass="associate-scroll"
                            hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox styleClass="pick-items-list">
                        <!-- To Pick -->
                        <VBox fx:id="pickItemsContainer" spacing="12">
                            <padding><Insets top="16" right="16" bottom="8" left="16"/></padding>
                        </VBox>
                        <!-- Picked (hidden until first item done) -->
                        <VBox fx:id="pickedSection" visible="false" managed="false">
                            <HBox styleClass="picked-section-header" alignment="CENTER_LEFT" spacing="10">
                                <Label text="✓  Picked" styleClass="picked-section-title"/>
                            </HBox>
                            <VBox fx:id="pickedContainer" spacing="12">
                                <padding><Insets top="12" right="16" bottom="16" left="16"/></padding>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </center>

        <bottom>
            <VBox styleClass="pick-footer">
                <Button fx:id="completeButton" text="Complete Pick &amp; Pack"
                        styleClass="pick-complete-button"
                        maxWidth="Infinity" prefHeight="54"
                        onAction="#onComplete" disable="true">
                    <font><Font name="System Bold" size="16"/></font>
                </Button>
            </VBox>
        </bottom>
    </BorderPane>

    <!-- ── Partial reason overlay (hidden until back is pressed mid-pick) ── -->
    <StackPane fx:id="partialOverlay" visible="false" styleClass="partial-overlay">
        <VBox styleClass="partial-dialog" maxWidth="480" StackPane.alignment="CENTER">

            <!-- Header -->
            <VBox styleClass="partial-dialog-header" spacing="6">
                <Label text="Mark as Partial Order" styleClass="partial-dialog-title"/>
                <Label fx:id="partialSubLabel" text="" styleClass="partial-dialog-sub"/>
            </VBox>

            <!-- Reason list (populated in code) -->
            <VBox fx:id="partialReasonList" styleClass="partial-reason-list" spacing="10">
                <padding><Insets top="20" right="20" bottom="8" left="20"/></padding>
            </VBox>

            <!-- Footer buttons -->
            <HBox styleClass="partial-dialog-footer" spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel" styleClass="partial-btn-cancel" onAction="#onPartialCancel"/>
                <Button text="Discard &amp; Go Back" styleClass="partial-btn-discard" onAction="#onPartialDiscard"/>
                <Button fx:id="partialConfirmBtn" text="Save as Partial"
                        styleClass="partial-btn-confirm" onAction="#onPartialConfirm" disable="true"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
